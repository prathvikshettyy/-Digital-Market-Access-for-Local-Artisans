{
  "name": "kalaconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm --prefix server start\" \"npm --prefix client dev\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm --prefix server start\" \"npm --prefix client dev\"",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
